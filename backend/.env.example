# Lokal Postgres örneği (docker):
#   docker run --name port-pg -e POSTGRES_USER=port -e POSTGRES_PASSWORD=port \
#     -e POSTGRES_DB=port_planning -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql+psycopg://port:port@localhost:5432/port_planning

# CORS: frontend origin'i (virgülle birden fazla verilebilir)
CORS_ORIGINS=http://localhost:3000
